{
  "crons": [
    {
      "path": "/api/auditoria?accion=limpieza",
      "schedule": "30 7 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "headers": [
    {
      "source": "/fuentes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
