# Puente self-hosted configuration. Copy to .env and fill it in: cp .env.example .env
# Generate every secret with:  openssl rand -hex 32
# Never commit .env. Values below are placeholders, not real secrets.

# --- Required ---
# Domain Caddy serves with automatic HTTPS. "localhost" works for a local test.
PUENTE_DOMAIN=localhost
# Public URL of the site (used in emails and links). Must match PUENTE_DOMAIN.
PUENTE_URL=https://localhost
# Postgres password (compose builds DATABASE_URL from it). Use hex so it is URL-safe.
DB_PASSWORD=
# Signs session cookies and codes: openssl rand -hex 32
SESSION_SECRET=
# Secret for the daily cleanup job (16+ chars): openssl rand -hex 32
CRON_SECRET=
# Platform account (superadmin) and the PIN that protects the first account creation.
ADMIN_EMAIL=
DOCENTE_PIN=

# --- Optional ---
# Time zone for dates (default America/Argentina/Buenos_Aires).
# PUENTE_ZONA=America/Argentina/Buenos_Aires
# Version shown by the health endpoint (for example a git commit).
# APP_COMMIT=

# --- Email: pick one ---
# SMTP: either one URL...
# SMTP_URL=smtp://user:password@smtp.example.org:587
# ...or separate fields.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=
# SMTP_FROM=Puente <puente@example.org>
# No email at all (LAN install): login codes are written to the server log only.
# SMTP_DISABLED=1

# --- Local AI (optional; start with: docker compose --profile llm up -d) ---
# LLM_BASE_URL=http://llm:11434/v1
# LLM_MODEL=
# LLM_API_KEY=
# CPU-only machines need minutes, not seconds:
# LLM_TIMEOUT_MS=120000
# LLM_AGENT_TIMEOUT_MS=180000
